APP_MODE=demo
APP_ORIGIN=http://127.0.0.1:3000
# Local development credentials only; replace with managed secrets in deployments.
DATABASE_URL=postgresql://ads_app:local-development-only@127.0.0.1:54329/goog_ad
ADMIN_DATABASE_URL=postgresql://postgres:local-development-only@127.0.0.1:54329/goog_ad
# Live identity requires Clerk configuration and seeded tenant memberships.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# GOOGLE_ADS_API_VERSION= (validate against official supported releases)
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_REFRESH_TOKEN=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# GOOGLE_ADS_CUSTOMER_IDS=2847558521
# GOOGLE_ADS_TENANT_ID= (provisioned tenant UUID)
# GOOGLE_ADS_WRITES_ENABLED=false
# GOOGLE_ADS_VALIDATE_ONLY=true
# HubSpot: Senior Care Stars. Account ID is public configuration, not a credential.
# HUBSPOT_ACCOUNT_ID=247696140
# HUBSPOT_CUSTOMER_ID=2847558521
# HUBSPOT_TENANT_ID= (same provisioned tenant UUID)
# HUBSPOT_PRIVATE_APP_TOKEN= (set through secret storage)
# HUBSPOT_CURRENCY= (verified Google Ads account currency)
# HUBSPOT_PIPELINE_ID= (required if milestone labels exist in multiple pipelines)
# HUBSPOT_CURRENCY_PROPERTY=deal_currency_code (verify custom payout/cost currency semantics)
