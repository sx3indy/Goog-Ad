                              "additionalProperties": false
                            }
                          },
                          "expectedImpact": {
                            "type": "object",
                            "properties": {
                              "metric": {
                                "type": "string"
                              },
                              "estimate": {
                                "type": "number"
                              },
                              "lowerBound": {
                                "type": "number"
                              },
                              "upperBound": {
                                "type": "number"
                              }
                            },
                            "required": [
                              "metric",
                              "estimate",
                              "lowerBound",
                              "upperBound"
                            ],
                            "additionalProperties": false
                          },
