                          "customerId",
                          "externalId",
                          "stage",
                          "finalized",
                          "revenueMicros",
                          "costMicros",
                          "currency",
                          "eventTime"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "action",
                      "outcome"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
