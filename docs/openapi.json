{
  "openapi": "3.1.0",
  "info": {
    "title": "AdOS control plane",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3000",
      "description": "Local demo only"
    }
  ],
  "security": [
    {
      "ClerkSession": []
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Database/identity readiness; not live integration certification",
        "responses": {
          "200": {
            "description": "Ready"
          },
          "503": {
            "description": "Unavailable"
          }
        }
      }
    },
    "/api/console": {
      "get": {
        "summary": "Tenant-scoped performance and control-plane view",
        "responses": {
          "200": {
            "description": "Successful operation"
          },
          "400": {
            "description": "Invalid strict-schema input"
          },
          "401": {
            "description": "Missing verified identity"
          },
          "403": {
            "description": "Role, tenant, or origin rejected"
          },
          "404": {
            "description": "Resource not found"
          },
          "409": {
            "description": "Duplicate or conflicting operation"
          },
          "413": {
            "description": "Body exceeds 32 KiB"
          },
          "415": {
            "description": "JSON required"
          },
          "422": {
            "description": "Policy or outcome validation failed"
          },
          "429": {
            "description": "60 writes per actor per minute exceeded"
          },
          "503": {
            "description": "Service unavailable or integration disabled"
          }
        }
      },
      "post": {
