                      "customerId",
                      "provider"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "action": {
                        "type": "string",
                        "const": "policy"
                      },
                      "customerId": {
                        "type": "string",
                        "pattern": "^\\d{10}$"
                      },
                      "policy": {
                        "type": "object",
                        "properties": {
                          "autonomy": {
                            "type": "string",
                            "enum": [
                              "L0",
                              "L1",
                              "L2",
                              "L3",
                              "L4"
                            ]
                          },
                          "dailyPlannedMicros": {
                            "type": "string",
                            "pattern": "^(0|[1-9][0-9]{0,17})$"
                          },
                          "maxReductionPercent": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 10
                          },
                          "freshnessMinutes": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 180
                          },
                          "minSampleSize": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          },
