FROM node:24-bookworm-slim
WORKDIR /app
COPY package*.json ./
COPY scripts/container-install.cjs scripts/container-install.cjs
RUN --mount=type=secret,id=cloud_https_proxy --mount=type=secret,id=cloud_http_proxy --mount=type=secret,id=cloud_ca node scripts/container-install.cjs --omit=dev
COPY --chown=node:node . .
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
USER node
CMD ["npm", "run", "worker:live"]
